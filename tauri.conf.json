{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Firebee",
  "version": "0.1.1",
  "identifier": "dev.firebee.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Firebee",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "app"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
